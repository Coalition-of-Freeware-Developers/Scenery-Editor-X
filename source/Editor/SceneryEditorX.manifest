<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Merged into the linker's manifest by the Manifest Tool.

  activeCodePage UTF-8 (Windows 10 1903 and later): the process's ANSI code page is UTF-8, so narrow strings and
  narrow file names are UTF-8 everywhere - std::filesystem::path::string() no longer throws for a folder outside the
  user's code page (C:\Users\<non-Latin name>\...), and libraries that open files with fopen (stb_image, FreeType,
  libconfig, FreeImage) take UTF-8 names like the rest of the editor. Older Windows ignores it; the code paths that
  matter at startup convert with VFS::ToUtf8 / VFS::FromUtf8 explicitly.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
