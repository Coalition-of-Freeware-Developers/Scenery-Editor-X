{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/bin/install/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/sedx-windows.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "$env{VULKAN_SDK}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "Debug-MSVC",
      "displayName": "Windows Debug (MSVC)",
      "description": "Debug build for Windows using MSVC compiler",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "Release-MSVC",
      "displayName": "Windows Release (MSVC)",
      "description": "Release build for Windows using MSVC compiler",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "Debug-Clang",
      "displayName": "Windows Debug (Clang)",
      "description": "Debug build for Windows using Clang compiler",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/bin/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/sedx-windows.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "$env{VULKAN_SDK}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "Release-Clang",
      "displayName": "Windows Release (Clang)",
      "description": "Release build for Windows using Clang compiler",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/bin/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/sedx-windows.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "$env{VULKAN_SDK}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/bin/install/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/sedx-linux.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_PREFIX_PATH": "$env{VULKAN_SDK}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Linux-Debug",
      "displayName": "Linux Debug",
      "description": "Debug build for Linux",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "Linux-Release",
      "displayName": "Linux Release",
      "description": "Release build for Linux",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mac-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/bin/install/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/sedx-mac.cmake",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_PREFIX_PATH": "$env{VULKAN_SDK}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "Mac-Debug",
      "displayName": "macOS Debug (ARM64)",
      "description": "Debug build for macOS ARM64",
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "Mac-Release",
      "displayName": "macOS Release (ARM64)",
      "description": "Release build for macOS ARM64",
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug-MSVC",
      "configurePreset": "Debug-MSVC",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "Release-MSVC",
      "configurePreset": "Release-MSVC",
      "configuration": "Release",
      "verbose": false
    },
    {
      "name": "Debug-Clang",
      "configurePreset": "Debug-Clang",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "Release-Clang",
      "configurePreset": "Release-Clang",
      "configuration": "RelWithDebInfo",
      "verbose": false
    },
    {
      "name": "Linux-Debug",
      "configurePreset": "Linux-Debug",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "Linux-Release",
      "configurePreset": "Linux-Release",
      "configuration": "Release",
      "verbose": false
    },
    {
      "name": "Mac-Debug",
      "configurePreset": "Mac-Debug",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "Mac-Release",
      "configurePreset": "Mac-Release",
      "configuration": "Release",
      "verbose": false
    }
  ],
  "testPresets": [
    {
      "name": "Debug-MSVC",
      "configurePreset": "Debug-MSVC",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Release-MSVC",
      "configurePreset": "Release-MSVC",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Debug-Clang",
      "configurePreset": "Debug-Clang",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Release-Clang",
      "configurePreset": "Release-Clang",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Linux-Debug",
      "configurePreset": "Linux-Debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Linux-Release",
      "configurePreset": "Linux-Release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Mac-Debug",
      "configurePreset": "Mac-Debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Mac-Release",
      "configurePreset": "Mac-Release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
