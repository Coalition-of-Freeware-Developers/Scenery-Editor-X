{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default-base",
      "hidden": true,
      "displayName": "Base - cross-platform (Ninja Multi-Config)",
      "description": "Common default base for Ninja multi-config builds across platforms",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/bin/install/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SEDX_ENABLE_VERSION_INCREMENT": "ON"
      }
    },

    {
      "name": "windows-ninja",
      "displayName": "Windows - Ninja (MSVC or Clang via toolset)",
      "inherits": "default-base",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/sedx-windows.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "$env{VULKAN_SDK}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "windows-ninja-clang-cl",
      "displayName": "Windows - Ninja (clang-cl)",
      "inherits": "windows-ninja",
      "cacheVariables": {
        "SEDX_PREFERRED_COMPILER": "CLANG_CL",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "windows-ninja-gcc",
      "displayName": "Windows - Ninja (GCC/MinGW)",
      "inherits": "windows-ninja",
      "cacheVariables": {
        "SEDX_PREFERRED_COMPILER": "GCC",
        "VCPKG_TARGET_TRIPLET": "x64-mingw"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "windows-msvc-vs2022",
      "displayName": "Windows - Visual Studio 2022 (native generator)",
      "description": "Use this preset when developing inside Visual Studio 2022. If you use Visual Studio 2026 change generator accordingly.",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/sedx-windows.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "SEDX_ENABLE_VERSION_INCREMENT": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "windows-msvc-vs2026",
      "displayName": "Windows - Visual Studio 2026 (native generator)",
      "description": "Preset for Visual Studio 2026. If your VS2026 generator has a different name, update the `generator` field accordingly.",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/sedx-windows.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "SEDX_ENABLE_VERSION_INCREMENT": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "linux-ninja",
      "displayName": "Linux - Ninja (gcc/clang)",
      "inherits": "default-base",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/sedx-linux.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_PREFIX_PATH": "$env{VULKAN_SDK}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "linux-ninja-gcc",
      "displayName": "Linux - Ninja (GCC)",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "SEDX_PREFERRED_COMPILER": "GCC",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "linux-ninja-clang",
      "displayName": "Linux - Ninja (Clang)",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "SEDX_PREFERRED_COMPILER": "CLANG",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "mac-ninja",
      "displayName": "macOS - Ninja (ARM64/Intel)",
      "inherits": "default-base",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/sedx-mac.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_PREFIX_PATH": "$env{VULKAN_SDK}",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "mac-ninja-clang",
      "displayName": "macOS - Ninja (Clang)",
      "inherits": "mac-ninja",
      "cacheVariables": {
        "SEDX_PREFERRED_COMPILER": "CLANG",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "windows-ninja-fastdebug",
      "displayName": "Windows - Ninja (Fast Debug, no version increment)",
      "inherits": "windows-ninja",
      "cacheVariables": {
        "SEDX_ENABLE_VERSION_INCREMENT": "OFF",
        "SEDX_FAST_CONFIG": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "linux-ninja-fastdebug",
      "displayName": "Linux - Ninja (Fast Debug, no version increment)",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "SEDX_ENABLE_VERSION_INCREMENT": "OFF",
        "SEDX_FAST_CONFIG": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "mac-ninja-fastdebug",
      "displayName": "macOS - Ninja (Fast Debug, no version increment)",
      "inherits": "mac-ninja",
      "cacheVariables": {
        "SEDX_ENABLE_VERSION_INCREMENT": "OFF",
        "SEDX_FAST_CONFIG": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "mac-xcode",
      "displayName": "macOS - Xcode (native generator)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/sedx-mac.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_PREFIX_PATH": "$env{VULKAN_SDK}",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "build-debug",
      "displayName": "Build Debug (multi-config)",
      "configurePreset": "windows-ninja",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "build-release",
      "displayName": "Build Release (multi-config)",
      "configurePreset": "windows-ninja",
      "configuration": "Release",
      "verbose": false
    },
    {
      "name": "build-windows-msvc",
      "displayName": "Build Windows (MSVC, VS2022)",
      "configurePreset": "windows-msvc-vs2022",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "build-windows-clang-cl-debug",
      "displayName": "Build Windows (clang-cl) Debug",
      "configurePreset": "windows-ninja-clang-cl",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "build-windows-gcc-debug",
      "displayName": "Build Windows (GCC/MinGW) Debug",
      "configurePreset": "windows-ninja-gcc",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "build-linux-gcc-debug",
      "displayName": "Build Linux (GCC) Debug",
      "configurePreset": "linux-ninja-gcc",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "build-linux-clang-debug",
      "displayName": "Build Linux (Clang) Debug",
      "configurePreset": "linux-ninja-clang",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "build-linux-gcc-release",
      "displayName": "Build Linux (GCC) Release",
      "configurePreset": "linux-ninja-gcc",
      "configuration": "Release",
      "verbose": false
    },
    {
      "name": "build-linux-clang-release",
      "displayName": "Build Linux (Clang) Release",
      "configurePreset": "linux-ninja-clang",
      "configuration": "Release",
      "verbose": false
    },
    {
      "name": "build-macos-clang-debug",
      "displayName": "Build macOS (Clang) Debug",
      "configurePreset": "mac-ninja-clang",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "build-fastdebug-windows",
      "displayName": "Build Fast Debug (Windows, no version increment)",
      "configurePreset": "windows-ninja-fastdebug",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "build-fastdebug-linux",
      "displayName": "Build Fast Debug (Linux, no version increment)",
      "configurePreset": "linux-ninja-fastdebug",
      "configuration": "Debug",
      "verbose": false
    },
    {
      "name": "build-fastdebug-macos",
      "displayName": "Build Fast Debug (macOS, no version increment)",
      "configurePreset": "mac-ninja-fastdebug",
      "configuration": "Debug",
      "verbose": false
    }
  ],

  "testPresets": [
    {
      "name": "ctest-debug",
      "configurePreset": "default-base",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ctest-release",
      "configurePreset": "default-base",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
